# Telegram bot token and webhook secret.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# PostgreSQL database credentials.
POSTGRES_ENGINE=postgresql+asyncpg
POSTGRES_DB=gestor
POSTGRES_USER=gestor
POSTGRES_PASSWORD=gestor
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# LLM — `provider/model`. A bare name lets LangChain infer the provider.
LLM_MODEL=deepseek/deepseek-v4-flash

LLM_HISTORY_MAX_MESSAGES=20
LLM_REQUEST_TIMEOUT=60.0

# Provider API keys — kept out of Settings; loaded into the process env for LangChain.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
