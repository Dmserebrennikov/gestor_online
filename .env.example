# Copy to .env at the repo root (same folder as docker-compose.yml).
#   copy .env.example .env
# That one file is read by Compose and by the FastAPI Settings class.
# .env is gitignored — never commit real tokens or production passwords.

TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Client (uvicorn on Windows) + Compose interpolation.
# Host port must match the left side of ports: in docker-compose.yml (default 5433).
POSTGRES_ENGINE=postgresql+asyncpg
POSTGRES_DB=gestor
POSTGRES_USER=gestor
POSTGRES_PASSWORD=gestor
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
