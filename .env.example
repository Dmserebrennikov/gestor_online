# Telegram bot token and webhook secret.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Comma-separated Telegram ids. An empty chat list denies every chat.
# An empty user list allows any speaker inside an allowed chat.
TELEGRAM_ALLOWED_CHAT_IDS=-1001234567890
TELEGRAM_ALLOWED_USER_IDS=111111,222222

# PostgreSQL database credentials.
POSTGRES_ENGINE=postgresql+asyncpg
POSTGRES_DB=gestor
POSTGRES_USER=gestor
POSTGRES_PASSWORD=gestor
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# LLM — `provider/model`. A bare name lets LangChain infer the provider.
LLM_MODEL=deepseek/deepseek-flash
# Optional. Used when a turn includes images. Unset: reuse LLM_MODEL (Flash has native vision).
# LLM_VISION_MODEL=google/gemini-3.7-flash

LLM_HISTORY_MAX_MESSAGES=20
LLM_REQUEST_TIMEOUT=60.0

# Speech-to-text — voice/audio notes are transcribed with the OpenAI API (needs OPENAI_API_KEY below).
STT_MODEL=gpt-4o-mini-transcribe
# Fallback language hint (ISO-639-1) when Telegram sends no language_code. Empty: no hint.
STT_LANGUAGE=es
STT_TIMEOUT=60.0

# Attachment archive. Default: <repo>/var/media
# MEDIA_DIR=

# Provider API keys — kept out of Settings; loaded into the process env for LangChain.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=  # necessary for voice/audio transcription (STT_* above).
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
